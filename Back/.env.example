# ── Servidor ─────────────────────────────────────────────
NODE_ENV=production
PORT=4000                       # Railway inyecta $PORT; en su UI usar PORT=${{PORT}}
HOST=0.0.0.0                    # obligatorio en Railway (localhost no es accesible)
API_PREFIX=/api
LOG_LEVEL=info

# ── URLs (sin barra final) ───────────────────────────────
BACKEND_URL=https://tu-servicio.up.railway.app
FRONTEND_URL=https://gastronomada.tudominio.com
FRONTEND_URL_WWW=https://www.gastronomada.tudominio.com
# ALLOWED_ORIGINS=https://a.com,https://b.com   # opcional: orígenes CORS extra
# BETTER_AUTH_URL se deriva de BACKEND_URL (ver src/config/auth/auth.ts)

# ── Base de datos (Postgres de Railway) ──────────────────
DATABASE_URL=postgresql://user:pass@host:5432/db   # en Railway: ${{Postgres.DATABASE_URL}}

# ── Better Auth ──────────────────────────────────────────
BETTER_AUTH_SECRET=genera-uno-con: openssl rand -base64 32
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com   # opcional (login Google)
# GOOGLE_CLIENT_SECRET=xxxx                           # opcional

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=GastroNómada <no-reply@tudominio.com>
DEV_EMAIL=tu-email-de-pruebas@tudominio.com

# ── Rate limiting ────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ── Swagger (desactivar en producción) ───────────────────
SWAGGER_ENABLED=false

# ── Opcionales ───────────────────────────────────────────
# CDN_URL=https://cdn.tudominio.com
# API_URL=https://tu-servicio.up.railway.app
# CSP_REPORT_URI=https://tudominio.com/csp-report
# INTERNAL_IPS=10.0.0.1,10.0.0.2
