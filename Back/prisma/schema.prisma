datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

// RBAC reducido: un usuario es miembro o no de la red social.
// El rol de administrador se gestiona vía better-auth (`isSuperAdmin`).
enum UserRole {
  MIEMBRO
  NO_MIEMBRO
}

// Tipo de cocina de una receta: permite filtrar tradicional vs. moderna.
enum TipoReceta {
  tradicional
  moderna
}

enum EmailType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  WELCOME
  NOTIFICATION
  MARKETING
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// ==========================================
// AUTHENTICATION & USERS
// ==========================================

model User {
  id            String   @id @default(uuid(7))
  email         String?  @unique
  name          String?
  image         String?
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  isSystem      Boolean  @default(false)
  isSuperAdmin  Boolean  @default(false)
  rol           UserRole @default(MIEMBRO)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Auth (better-auth)
  accounts  Account[]
  sessions  Session[]
  emailLogs EmailLog[]

  // Dominio GastroNómada
  recetas        Receta[]       @relation("UserRecetas")
  mensajes       Mensaje[]      @relation("UserMensajes")
  conversaciones Conversacion[] @relation("UserConversaciones")

  @@index([email])
  @@index([isActive])
  @@map("auth_users")
}

model Account {
  id                    String    @id @default(uuid(7))
  userId                String
  providerId            String
  accountId             String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id        String   @id @default(uuid(7))
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  isValid   Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([token])
  @@index([isValid])
  @@map("auth_sessions")
}

model Verification {
  id         String    @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("auth_verification")
}

model LoginAttempt {
  id         String   @id @default(uuid(7))
  email      String
  success    Boolean
  ipAddress  String?
  userAgent  String?  @db.Text
  failReason String?
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([success])
  @@map("auth_login_attempts")
}

// ==========================================
// COMMUNICATIONS
// ==========================================

model EmailLog {
  id         String      @id @default(uuid(7))
  userId     String?
  recipient  String
  subject    String
  body       String      @db.Text
  type       String
  status     EmailStatus
  provider   String      @default("resend")
  providerId String?     @unique

  templateId String?
  metadata   Json?

  error String? @db.Text

  sentAt    DateTime?
  openedAt  DateTime?
  clickedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("email_log")
}

// ==========================================
// ENTIDADES DE NEGOCIO — GASTRONÓMADA
// ==========================================
//
// Modelos de dominio de la red social. Relación 1:n con el usuario autor.

/// Receta publicada por un usuario.
/// `imagen` se almacena en base64 (data URL). El detalle (descripción, raciones,
/// ingredientes y pasos) se aplana en columnas para poder consultarlo/validarlo.
model Receta {
  id           String     @id @default(uuid(7))
  nombre       String
  tipo         TipoReceta @default(tradicional) // tradicional | moderna
  pais         String     @default("") // país de origen, para filtrar el feed
  imagen       String     @db.Text // base64 (data URL)
  descripcion  String     @db.Text
  raciones     String? // texto orientativo, p. ej. "4 personas"
  ingredientes String[]
  pasos        String[]

  userId String
  user   User   @relation("UserRecetas", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([nombre])
  @@index([tipo])
  @@index([pais])
  @@map("recetas")
}

/// Mensaje del foro gastronómico escrito por un usuario.
/// `autor` es el nombre mostrado (denormalizado para el feed público).
model Mensaje {
  id    String   @id @default(uuid(7))
  autor String
  texto String   @db.Text
  fecha DateTime @default(now())

  userId String
  user   User   @relation("UserMensajes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fecha])
  @@map("mensajes")
}

/// Hilo de conversación del buzón de un usuario.
/// `usuario` es el handle del interlocutor y hace de id/slug del hilo.
model Conversacion {
  id      String @id @default(uuid(7))
  usuario String

  userId String
  user   User   @relation("UserConversaciones", fields: [userId], references: [id], onDelete: Cascade)

  mensajes ConversacionMensaje[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, usuario])
  @@index([userId])
  @@map("conversaciones")
}

/// Mensaje individual dentro de un hilo de conversación.
/// `propio` = lo envió el dueño del hilo; `leido` = marca de lectura.
model ConversacionMensaje {
  id     String   @id @default(uuid(7))
  texto  String   @db.Text
  fecha  DateTime @default(now())
  propio Boolean  @default(false)
  leido  Boolean  @default(false)

  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId])
  @@map("conversacion_mensajes")
}
