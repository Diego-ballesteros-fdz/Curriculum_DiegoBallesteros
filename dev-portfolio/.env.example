# URL interna del backend (Fastify + better-auth). SERVER-ONLY (sin NEXT_PUBLIC_).
# El front reescribe /api/* hacia aquí (ver next.config.ts) y el SSR lee la
# sesión llamando a este origen. En producción: la URL real del backend.
BACKEND_URL=http://localhost:4000

# baseURL del cliente better-auth. Déjala VACÍA: el cliente usa el mismo origen
# del front y Next reescribe /api/auth/* al backend (la cookie de sesión queda en
# este dominio y el SSR puede leerla). Solo defínela si el cliente debiera hablar
# directo con el back, sin pasar por el proxy.
NEXT_PUBLIC_AUTH_URL=

# WebSocket del backend para el tiempo real (foro, mensajes directos,
# notificaciones). El navegador conecta directo al back; la autenticación viaja
# en el mensaje `auth` con el session.token de Better Auth (no la cookie httpOnly).
# Dev: ws://localhost:4000/api/ws. Producción: wss://<dominio-backend>/api/ws.
NEXT_PUBLIC_WS_URL=ws://localhost:4000/api/ws
